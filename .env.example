DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="titchybook-uploads"

ADMIN_EMAIL="admin@titchybook.com"
ADMIN_PASSWORD="replace-with-a-strong-local-password"

OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-6-sol"

RESEND_API_KEY="re_your-api-key-here"
# For testing: use "onboarding@resend.dev"
# For production: use your verified domain like "noreply@yourdomain.com"
EMAIL_FROM="onboarding@resend.dev"

# Stripe Checkout (online payment). Without these the app still works:
# orders stay PENDING_PAYMENT and an admin marks them PAID manually.
# STRIPE_SECRET_KEY: sk_test_... locally, sk_live_... in production.
# STRIPE_WEBHOOK_SECRET: from `stripe listen` locally, or the Stripe
# dashboard endpoint secret for https://APP/api/stripe/webhook in production.
STRIPE_SECRET_KEY="sk_test_replace-with-your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-webhook-signing-secret"

# Separate persistent process: npm run worker:render
# Fixed queue lease: 120 seconds; heartbeat: 20 seconds; three attempts.
RENDER_WORKER_POLL_MS=2000
VECTOR_RENDER=false

# Autonomous AI book pipeline: npm run worker:ai
# Lease: 120 seconds (default); heartbeat: 60 seconds; three attempts.
AI_WORKER_POLL_MS=2000
AI_MAX_ACTIVE_JOBS=2
AI_QA_SAMPLE_RATE=0.1
# Generation switches. Text generation is the shipped capability and stays on
# unless explicitly disabled; illustrated generation stays off until the
# Release B gate passes, so the manual/editor flows remain the fallback.
AI_TEXT_BOOKS_ENABLED=true
AI_ILLUSTRATED_BOOKS_ENABLED=false
# Bounds on one text job, independent of infrastructure retries: repair cycles
# spent on QA-rejected text, total lifetime measured from the first claim, and
# the pause before re-checking the render dependency.
AI_BOOK_MAX_REPAIRS=2
AI_BOOK_LIFETIME_MS=1800000
AI_BOOK_CONTINUE_DELAY_MS=10000
AI_RENDER_POLL_MS=5000
# Default 120000 suits both hosts: on Vercel (serverless drain) an abandoned
# or yielded job slice frees well before the next 5-minute cron tick, and it
# must exceed DRAIN_BUDGET_MS so a live drainer is never evicted mid-budget.
# Long-lived workers may raise it (max 300000); startup validation enforces
# the lease/budget/heartbeat relationships.
AI_BOOK_LEASE_MS=120000

# Serverless queue drain (Vercel): the long-lived workers above cannot run on
# Vercel, so the AI/render queues are drained by secret-guarded routes
# (api/ai/drain, api/render/drain) driven by .github/workflows/drain.yml.
# CRON_SECRET must equal the GitHub repo secret of the same name; the routes
# fail closed with 401 when it is unset or mismatched. Generate: openssl rand -hex 32
CRON_SECRET="change-me-to-a-random-64-char-hex-secret"
# Per-invocation work budget in ms; must stay under the routes' maxDuration (60s).
DRAIN_BUDGET_MS=45000
# Health thresholds for GET /api/queue/health (CRON_SECRET-guarded). The
# defaults tolerate two missed 5-minute drain runs and flag runnable work
# older than 30 minutes; the workflow fails when the endpoint returns 503.
QUEUE_STALE_DRAIN_MS=900000
QUEUE_BACKLOG_ALERT_MS=1800000
# Note: PROD_URL is a GitHub Actions secret only (the drain target origin, no
# trailing slash). It is NOT a Vercel environment variable.

# Test commands require a separate local database with 'test' in its name.
# TEST_DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:55432/titchybook_test"
