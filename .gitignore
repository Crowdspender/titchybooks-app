# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.npm-cache
test-*.png
# Manual browser-verification screenshots captured at the repo root during
# registration/dashboard walkthroughs. They can contain real account data, so
# they are never committed.
/step*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local database backup drills (may contain user data)
/backup/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Local test/build run transcripts (verbose, machine-specific, regenerable).
/integration-run.log
/build-check.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.vercel-tmp

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
