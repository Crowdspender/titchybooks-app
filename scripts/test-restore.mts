// A local, disposable rehearsal, not a production restore utility. Nothing is
// added to the selected base database. Only names generated by this invocation
// can be created/restored/dropped. Docker's remote-context variables are omitted.
const scratchPattern = /^batch7_restore_test_[0-9a-f]{24}_(source|restored)$/;
export function scratchNames(token: string) {
  assert.match(token, /^[0-9a-f]{24}$/);
  return { source: `batch7_restore_test_${token}_source`, restored: `batch7_restore_test_${token}_restored` };
}
export function assertScratch(name: string, base: string, owned: ReadonlySet<string>) {
  assert.ok(scratchPattern.test(name) && name !== base && owned.has(name), 'Refusing a non-owned scratch database');
}
export function cleanupOwnedScratch(base: string, created: Set<string>, drop: (name: string) => void) {
  // Validate the entire set before any write, then attempt every exact owned name.
  for (const name of created) assertScratch(name, base, created);
  const failures: unknown[] = [];
  for (const name of created) {
    try { drop(name); created.delete(name); }
    catch (error) { failures.push(error); }
  }
  if (failures.length) throw new AggregateError(failures, `Owned scratch cleanup failed: ${[...created].join(', ')}`);
}
export function restoreTarget(raw: string) {
  const env = testEnvironment();
  assert.equal(raw, env.TEST_DATABASE_URL);
  const url = new URL(raw);
  assert.ok(['127.0.0.1', 'localhost'].includes(url.hostname), 'Restore requires IPv4 loopback');
  assert.ok([...url.searchParams].every(([key, value]) => key === 'schema' && value === 'public'),
    'Restore URL permits only schema=public');
  const container = url.port === '55432' ? 'titchybook-sprint-test'
    : url.port === '55433' ? 'titchybook-b1-pg17' : null;
  assert.ok(container, 'Restore requires the explicitly designated local PG16/17 container port');
  assert.ok(url.username && url.password, 'Explicit local test credentials required');
  return { url, container, base: url.pathname.slice(1), major: url.port === '55432' ? 16 : 17 };
}
function digest(value: string | Buffer) { return createHash('sha256').update(value).digest('hex'); }
function identifier(value: string) { return `"${value.replaceAll('"', '""')}"`; }
export function canonicalCheck(name: string, definition: string) {
  // PG dump deparses BETWEEN into two comparisons; reparsing flattens nested
  // associative AND. Normalize only this observed grouping in the two named
  // guards. No OR/operator/constant/type or other constraint changes are ignored.
  if (!['Order.Order_charge_range', 'PaymentAttempt.PaymentAttempt_charge_valid'].includes(name)) return definition;
  return definition.replace('(("expectedMinorAmount" >= 1) AND ("expectedMinorAmount" <= 99999999)) AND',
    '("expectedMinorAmount" >= 1) AND ("expectedMinorAmount" <= 99999999) AND');
}
function client(url: string) { return new PrismaClient({ datasources: { db: { url } } }); }

async function snapshot(db: PrismaClient) {
  // Hash complete row content, not just User counts. OIDs/statistics/owners/ACLs
  // are intentionally excluded: this matches the backup workflow's no-owner /
  // no-privileges format, not provider-managed role or PITR certification.
  const schemas = await db.$queryRawUnsafe<Array<{ name: string }>>(
    `SELECT nspname AS name FROM pg_namespace WHERE nspname NOT LIKE 'pg_%'
      AND nspname <> 'information_schema' ORDER BY nspname`);
  const tables = await db.$queryRawUnsafe<Array<{ schema: string; name: string; kind: string }>>(
    `SELECT n.nspname AS schema, c.relname AS name, c.relkind::text AS kind
     FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
     WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname <> 'information_schema'
       AND c.relkind IN ('r','p','m','S') ORDER BY 1,2`);
  const rows: Record<string, { count: number; sha256: string }> = {};
  for (const table of tables) {
    const qualified = `${identifier(table.schema)}.${identifier(table.name)}`;
    const content = table.kind === 'S'
      ? await db.$queryRawUnsafe(`SELECT last_value::text, is_called FROM ${qualified}`)
      : await db.$queryRawUnsafe(`SELECT to_jsonb(r) AS row FROM ${qualified} r ORDER BY to_jsonb(r)::text`);
    rows[`${table.schema}.${table.name}`] = { count: (content as unknown[]).length, sha256: digest(JSON.stringify(content)) };
  }
  const catalogs = await db.$queryRawUnsafe<Array<{ kind: string; schema: string; name: string; definition: string }>>(`
    SELECT 'column' AS kind, n.nspname AS schema, c.relname || '.' || a.attname AS name,
      jsonb_build_array(a.attnum,format_type(a.atttypid,a.atttypmod),a.attnotnull,
        pg_get_expr(d.adbin,d.adrelid),a.attidentity,a.attgenerated)::text AS definition
    FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid
      JOIN pg_namespace n ON n.oid=c.relnamespace
      LEFT JOIN pg_attrdef d ON d.adrelid=c.oid AND d.adnum=a.attnum
    WHERE a.attnum>0 AND NOT a.attisdropped AND c.relkind IN ('r','p','v','m')
      AND n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
    UNION ALL
    SELECT 'constraint', n.nspname, c.relname || '.' || k.conname, pg_get_constraintdef(k.oid)
    FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
    UNION ALL
    SELECT 'index', schemaname, indexname, indexdef FROM pg_indexes
    WHERE schemaname NOT LIKE 'pg_%' AND schemaname<>'information_schema'
    UNION ALL
    SELECT 'trigger', n.nspname, c.relname || '.' || t.tgname, pg_get_triggerdef(t.oid)
    FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE NOT t.tgisinternal AND n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
    UNION ALL
    SELECT 'function', n.nspname, p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')', pg_get_functiondef(p.oid)
    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
    WHERE p.prokind IN ('f','p') AND n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
    UNION ALL
    SELECT 'enum', n.nspname, t.typname, string_agg(e.enumlabel,',' ORDER BY e.enumsortorder)
    FROM pg_type t JOIN pg_enum e ON e.enumtypid=t.oid JOIN pg_namespace n ON n.oid=t.typnamespace
    WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema' GROUP BY n.nspname,t.typname
    UNION ALL
    SELECT 'view', schemaname, viewname, definition FROM pg_views
    WHERE schemaname NOT LIKE 'pg_%' AND schemaname<>'information_schema'
    UNION ALL
    SELECT 'policy', schemaname, tablename || '.' || policyname,
      jsonb_build_array(permissive,roles,cmd,qual,with_check)::text FROM pg_policies
    WHERE schemaname NOT LIKE 'pg_%' AND schemaname<>'information_schema'
    UNION ALL
    SELECT 'row-security', n.nspname, c.relname, jsonb_build_array(c.relrowsecurity,c.relforcerowsecurity)::text
    FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
    WHERE c.relkind IN ('r','p') AND n.nspname NOT LIKE 'pg_%' AND n.nspname<>'information_schema'
    ORDER BY 1,2,3,4`);
  for (const item of catalogs) if (item.kind === 'constraint') item.definition = canonicalCheck(item.name, item.definition);
  return { schemas, rows, catalogs, catalogSha256: digest(JSON.stringify(catalogs)), catalogEntries: catalogs.length };
}

async function fixture(db: PrismaClient) {
  const now = new Date('2020-01-02T03:04:05Z');
  const user = await db.user.create({ data: { email: 'restore-owner@example.invalid', passwordHash: 'not-a-login-password', name: 'Émilie — original' } });
  const admin = await db.user.create({ data: { email: 'restore-admin@example.invalid', passwordHash: 'not-a-login-password', role: 'ADMIN' } });
  const image = await sharp({ create: { width: 320, height: 240, channels: 3, background: '#345678' } }).png().toBuffer();
  const asset = await db.asset.create({ data: { userId: user.id, s3Key: `assets/${user.id}/original.png`,
    originalFilename: 'Émilie.png', mimeType: 'image/png', fileSize: image.length, width: 320, height: 240, deletedAt: now } });
  const pages = createEmptySubmissionPageSeeds().map(({ pageLabel, order, sceneJson }) => ({ pageLabel, order, sceneJson }));
  const template = await db.submission.create({ data: { userId: admin.id, mode: 'TEMPLATE', status: 'APPROVED',
    isTemplate: true, title: 'Original template', version: 2, pages: { create: pages } } });
  const pin = { templateId: template.id, version: 2, pages: pages.map(p => ({ ...p, assetId: asset.id })) };
  const book = await db.submission.create({ data: { userId: user.id, mode: 'EDITOR', status: 'APPROVED',
    title: 'Preserved Émilie', revision: 4, templateId: template.id, templateVersion: 2, pinnedTemplate: pin,
    pages: { create: pages.map(p => ({ ...p, revision: 4,
      sceneJson: JSON.stringify({ ...JSON.parse(p.sceneJson), elements: [{ type: 'image', id: 'original-image', assetId: asset.id }] }) })) } } });
  const job = await db.renderJob.create({ data: { submissionId: book.id, status: 'COMPLETED',
    inputSnapshot: { submissionId: book.id, pinnedTemplate: pin, assetId: asset.id }, completedAt: now } });
  const objects = new Map<string, Buffer>([[asset.s3Key, image]]);
  const descriptions = {} as Record<'print' | 'reading', Awaited<ReturnType<typeof describeArtifact>>>;
  for (const kind of ['print', 'reading'] as const) {
    const pdf = await PDFDocument.create();
    const [width, height, count] = kind === 'print' ? [297, 210, 1] : [74, 105, 8];
    for (let page = 0; page < count; page++) {
      const p = pdf.addPage([width * 72 / 25.4, height * 72 / 25.4]);
      p.drawImage(await pdf.embedPng(image), { x: 10, y: 10, width: 80, height: 60 });
    }
    const bytes = Buffer.from(await pdf.save()); const s3Key = `renders/${book.id}/${job.id}/${kind}.pdf`;
    objects.set(s3Key, bytes); descriptions[kind] = await describeArtifact({ kind, s3Key, bytes });
  }
  const manifest = { schemaVersion: 1, submissionId: book.id, submissionRevision: 4, renderJobId: job.id,
    printProfile: 'synthetic-restore-only', templateId: template.id, templateVersion: 2, title: book.title,
    createdAt: now.toISOString(), print: { ...descriptions.print }, reading: { ...descriptions.reading } };
  await db.submission.update({ where: { id: book.id }, data: { pdfS3Key: descriptions.print.s3Key,
    readingPdfS3Key: descriptions.reading.s3Key, artifactManifest: manifest } });
  await db.renderJob.update({ where: { id: job.id }, data: { pdfS3Key: descriptions.print.s3Key,
    readingPdfS3Key: descriptions.reading.s3Key, artifactManifest: manifest } });
  await db.aiBookJob.create({ data: { userId: user.id, submissionId: book.id, templateId: template.id,
    concept: 'Synthetic recovery job', status: 'QUEUED', stage: 'RENDER', renderJobId: job.id,
    stageOutput: { pinnedTemplate: pin }, requestKey: 'recovery-ai-original', payloadDigest: 'original' } });
  const base = { userId: user.id, submissionId: book.id, quantity: 1, zone: 'HU', weightGrams: 200, shippingBand: 0,
    vaultAddOn: true, vaultFeeHuf: 2000, unitPriceHuf: 3000, printCostHuf: 3000, shippingCostHuf: 1000,
    totalHuf: 6000, currency: 'HUF', pricingConfigVersion: 7,
    recipientName: 'Synthetic Recipient', line1: 'Test Street 1', city: 'Budapest', postalCode: '1000', countryCode: 'HU' };
  const order = await db.order.create({ data: { ...base, status: 'SHIPPED', paidAt: now, expectedMinorAmount: 600000,
    quoteSnapshot: { amountMinor: 600000, currency: 'HUF', rounding: 'synthetic', terms: 'original' },
    fxRate: '1', quoteAcceptedAt: now, requestKey: 'restore-original', requestDigest: 'original',
    paymentState: 'PARTIALLY_REFUNDED', paymentHold: true, paymentRevision: 3,
    paymentSummary: { receivedMinor: 600000, refundedMinor: 100000 } } });
  const attempt = await db.paymentAttempt.create({ data: { orderId: order.id, sequence: 1, idempotencyKey: 'restore-attempt',
    expectedMinorAmount: 600000, currency: 'HUF', livemode: false, providerRequest: { mode: 'payment' },
    sessionId: 'cs_restore', paymentIntentId: 'pi_restore', status: 'SUCCEEDED', requestStartedAt: now } });
  await db.paymentEvent.create({ data: { providerEventId: 'evt_restore', source: 'SIGNED_WEBHOOK', type: 'charge.refunded',
    orderId: order.id, attemptId: attempt.id, data: { objectId: 'ch_restore', amountRefunded: 100000 },
    dataDigest: 'synthetic-original', status: 'PROCESSED', processedAt: now } });
  await db.paymentEvent.create({ data: { providerEventId: 'evt_restore_orphan', source: 'SIGNED_WEBHOOK', type: 'refund.updated',
    data: { objectId: 're_restore' }, dataDigest: 'synthetic-orphan', status: 'UNMATCHED' } });
  await db.vaultEntry.create({ data: { orderId: order.id, submissionId: book.id, title: book.title!,
    authorName: user.name!, quantity: 2, status: 'WITHDRAWN', publicConsent: true, storedAt: now, withdrawnAt: now } });
  const legacy = await db.order.create({ data: { ...base, status: 'PAID', paidAt: now,
    manualSettlement: { operatorUserId: admin.id, at: now.toISOString(), evidence: 'Synthetic bank receipt' } } });
  await db.vaultEntry.create({ data: { orderId: legacy.id, submissionId: book.id, title: 'Private original',
    authorName: user.name!, publicConsent: false, storedAt: now } });
  await db.paymentAlert.create({ data: { orderId: order.id, kind: 'payment-review', message: 'Synthetic review', dedupeKey: 'restore-alert' } });
  await db.pricingConfig.create({ data: { id: 'default', version: 7, enabledZones: '["HU"]', weightBands: '[2000]',
    shippingTable: '{"HU":[1000]}', priceTiers: '[{"minQty":1,"unitPriceHuf":3000}]', currencyRates: '{"HUF":1,"EUR":0.0026,"GBP":0.0022}' } });
  // Never touch the provider-managed schema on the base DB. This synthetic
  // schema exists only in the fresh SOURCE DB; its definitions and data must
  // survive the full logical restore, including sequence, policy and function.
  await db.$executeRawUnsafe('CREATE SCHEMA neon_auth');
  await db.$executeRawUnsafe("CREATE TYPE neon_auth.restore_state AS ENUM ('original','retained')");
  await db.$executeRawUnsafe(`CREATE TABLE neon_auth.restore_probe (id bigserial PRIMARY KEY, value text NOT NULL,
    state neon_auth.restore_state NOT NULL DEFAULT 'original')`);
  await db.$executeRawUnsafe("INSERT INTO neon_auth.restore_probe(value) VALUES ('Émilie — retain provider probe')");
  await db.$executeRawUnsafe('ALTER TABLE neon_auth.restore_probe ENABLE ROW LEVEL SECURITY');
  await db.$executeRawUnsafe('CREATE POLICY restore_probe_read ON neon_auth.restore_probe FOR SELECT USING (true)');
  await db.$executeRawUnsafe('CREATE FUNCTION neon_auth.restore_identity(value text) RETURNS text LANGUAGE sql IMMUTABLE AS $$ SELECT value $$');
  await db.$executeRawUnsafe('CREATE VIEW neon_auth.restore_view AS SELECT id, value FROM neon_auth.restore_probe');
  return { orderId: order.id, attemptId: attempt.id, bookId: book.id, assetId: asset.id, objects, descriptions };
}

export async function rehearse() {
  const env = testEnvironment(); const target = restoreTarget(env.TEST_DATABASE_URL);
  const launchEnv = { ...offlineTestEnvironment(), PGUSER: decodeURIComponent(target.url.username),
    PGPASSWORD: decodeURIComponent(target.url.password) };
  function command(executable: string, args: string[], input?: Buffer) {
    const result = spawnSync(executable, args, { env: launchEnv, input, timeout: 180000, maxBuffer: 32 * 1024 * 1024 });
    // Do not emit a connection URL, subprocess environment or command on error.
    assert.equal(result.error, undefined, `${executable} unavailable or timed out`);
    assert.equal(result.status, 0, `${executable} failed: ${result.stderr?.toString().slice(0, 2000)}`);
    return result.stdout;
  }
  const inspect = JSON.parse(command('docker', ['inspect', target.container]).toString())[0];
  assert.equal(inspect.State.Running, true);
  const bindings = inspect.NetworkSettings.Ports['5432/tcp'];
  assert.equal(bindings.length, 1);
  assert.equal(bindings[0].HostIp, '127.0.0.1');
  assert.equal(bindings[0].HostPort, target.url.port);
  const names = scratchNames(randomUUID().replaceAll('-', '').slice(0, 24));
  const created = new Set<string>();
  const tool = (args: string[], input?: Buffer) => command('docker', ['run', '--rm', '-i', '--pull=never',
    '--network', `container:${target.container}`, '-e', 'PGUSER', '-e', 'PGPASSWORD', `postgres:${target.major}`, ...args], input);
  const psql = (database: string, sql: string) => tool(['psql', '-X', '-v', 'ON_ERROR_STOP=1', '-h', '127.0.0.1', '-d', database, '-c', sql]);
  const base = client(env.DATABASE_URL);
  let source: PrismaClient | undefined; let restored: PrismaClient | undefined;
  let before: Awaited<ReturnType<typeof snapshot>> | undefined;
  const output = resolve('test-results', `batch7-restore-pg${target.major}`);
  const startedAt = new Date().toISOString();
  let report: Record<string, unknown> | undefined;
  mkdirSync(output, { recursive: true });
  // Supersede prior evidence before any scratch work. A failed/incomplete run
  // cannot leave the previous run's passing JSON presented as current evidence.
  writeFileSync(resolve(output, 'evidence.json'), JSON.stringify({ status: 'INCOMPLETE', startedAt,
    postgresMajor: target.major, plannedScratchDatabases: names,
    scope: 'Disposable local synthetic restore; no passing claim until cleanup' }, null, 2) + '\n');
  console.log(`Planned local scratch databases: ${names.source}, ${names.restored}`);
  try {
    const [{ version }] = await base.$queryRawUnsafe<Array<{ version: string }>>("SELECT current_setting('server_version_num') AS version");
    assert.equal(Math.floor(Number(version) / 10000), target.major);
    before = await snapshot(base);
    const owned = new Set(Object.values(names));
    for (const name of Object.values(names)) {
      assertScratch(name, target.base, owned);
      psql(target.base, `CREATE DATABASE ${identifier(name)} TEMPLATE template0`);
      created.add(name);
    }
    const scratchUrl = (name: string) => { const url = new URL(env.DATABASE_URL); url.pathname = `/${name}`; return url.toString(); };
    const migration = spawnSync(process.execPath, ['node_modules/prisma/build/index.js', 'migrate', 'deploy'], {
      env: { ...env, DATABASE_URL: scratchUrl(names.source), TEST_DATABASE_URL: scratchUrl(names.source) },
      encoding: 'utf8', timeout: 180000,
    });
    assert.equal(migration.error, undefined, 'Scratch migration unavailable');
    assert.equal(migration.status, 0, 'Scratch migrations failed');
    source = client(scratchUrl(names.source)); restored = client(scratchUrl(names.restored));
    const seed = await fixture(source); const expected = await snapshot(source);
    const dump = tool(['pg_dump', '-h', '127.0.0.1', '-d', names.source, '--format=custom', '--no-owner', '--no-privileges']);
    assert.ok(dump.length > 0); assert.equal(dump.subarray(0, 5).toString(), 'PGDMP');
    const listing = tool(['pg_restore', '--list'], dump).toString();
    assert.match(listing, /neon_auth/); assert.match(listing, /PaymentAttempt/); assert.match(listing, /TRIGGER/);
    writeFileSync(resolve(output, 'synthetic.dump'), dump);
    assertScratch(names.restored, target.base, owned);
    tool(['pg_restore', '-h', '127.0.0.1', '-d', names.restored, '--exit-on-error', '--single-transaction', '--no-owner', '--no-privileges'], dump);
    assert.deepEqual(await snapshot(restored), expected, 'Full restored rows/catalog differ from source');
    // Exercise restored guards, not just their catalog presence.
    await assert.rejects(restored.order.update({ where: { id: seed.orderId }, data: { totalHuf: 1 } }), /immutable/);
    await assert.rejects(restored.paymentAttempt.update({ where: { id: seed.attemptId }, data: { expectedMinorAmount: 700000 } }), /immutable/);
    const originalVault = await restored.vaultEntry.findUniqueOrThrow({ where: { orderId: seed.orderId } });
    await assert.rejects(restored.vaultEntry.create({ data: { orderId: seed.orderId, submissionId: seed.bookId,
      title: 'Duplicate', authorName: 'Synthetic' } }), /Unique constraint/);
    assert.deepEqual(await restored.vaultEntry.findUniqueOrThrow({ where: { orderId: seed.orderId } }), originalVault);
    const legacy = await restored.order.findFirstOrThrow({ where: { requestKey: null } });
    assert.equal(legacy.quoteSnapshot, null); assert.equal(legacy.fxRate, null); assert.equal(legacy.paymentState, null);
    const legacyData = { userId: legacy.userId, submissionId: legacy.submissionId, quantity: legacy.quantity,
      zone: legacy.zone, weightGrams: legacy.weightGrams, shippingBand: legacy.shippingBand,
      vaultAddOn: legacy.vaultAddOn, vaultFeeHuf: legacy.vaultFeeHuf, unitPriceHuf: legacy.unitPriceHuf,
      printCostHuf: legacy.printCostHuf, shippingCostHuf: legacy.shippingCostHuf, totalHuf: legacy.totalHuf,
      currency: legacy.currency, pricingConfigVersion: legacy.pricingConfigVersion,
      recipientName: legacy.recipientName, line1: legacy.line1, city: legacy.city,
      postalCode: legacy.postalCode, countryCode: legacy.countryCode };
    // Invalid inserts reach CHECK constraints (not an immutable-update trigger).
    for (const expectedMinorAmount of [0, -1, 99999999, 100000000, 600001]) {
      await assert.rejects(restored.order.create({ data: { ...legacyData, expectedMinorAmount } }), /Order_charge_range/);
    }
    await assert.rejects(restored.order.create({ data: { ...legacyData, expectedMinorAmount: 600000, currency: 'USD' } }), /Order_charge_range/);
    for (const expectedMinorAmount of [0, -1, 600001, 100000000]) {
      await assert.rejects(restored.paymentAttempt.create({ data: { orderId: legacy.id, sequence: 1,
        idempotencyKey: 'invalid-restore-insert', expectedMinorAmount, currency: 'HUF', livemode: false,
        providerRequest: {} } }), /PaymentAttempt_charge_valid/);
    }
    await restored.$transaction(async (tx: Prisma.TransactionClient) => {
      await tx.order.update({ where: { id: legacy.id }, data: { paymentHold: true } });
      await assert.rejects(tx.order.update({ where: { id: legacy.id }, data: { status: 'IN_PRODUCTION' } }), /Payment review/);
      throw new Error('ROLLBACK_RESTORE_GUARD');
    }).catch(error => { if (!(error instanceof Error) || error.message !== 'ROLLBACK_RESTORE_GUARD') throw error; });
    assert.deepEqual(await snapshot(restored), expected, 'Guard probes must not alter restored history');
    // Local retained-object model: recover an exact independently held copy.
    // This does NOT claim S3/PITR/version-policy recovery or real reader printing.
    const backupObjects = new Map([...seed.objects].map(([key, bytes]) => [key, Buffer.from(bytes)]));
    seed.objects.clear(); assert.equal(seed.objects.size, 0);
    const missing = await restored.submission.findUniqueOrThrow({ where: { id: seed.bookId } });
    assert.ok(missing.pdfS3Key && !seed.objects.has(missing.pdfS3Key));
    for (const [key, bytes] of backupObjects) seed.objects.set(key, Buffer.from(bytes));
    for (const kind of ['print', 'reading'] as const) {
      const descriptor = seed.descriptions[kind]; const bytes = seed.objects.get(descriptor.s3Key)!;
      assert.deepEqual(await verifyArtifact(kind, descriptor, bytes), []);
      assert.ok((await verifyArtifact(kind, descriptor, bytes.subarray(0, bytes.length - 1))).length > 0);
      writeFileSync(resolve(output, `${kind}.pdf`), bytes);
    }
    const asset = await restored.asset.findUniqueOrThrow({ where: { id: seed.assetId } });
    const sourceImage = seed.objects.get(asset.s3Key)!;
    assert.equal(sourceImage.length, asset.fileSize);
    assert.equal(digest(sourceImage), digest(backupObjects.get(asset.s3Key)!));
    const metadata = await sharp(sourceImage).metadata();
    assert.equal(metadata.width, asset.width); assert.equal(metadata.height, asset.height);
    assert.deepEqual(await snapshot(base), before, 'Selected base database changed');
    report = { status: 'PASSED', startedAt,
      scope: 'Disposable local synthetic logical restore and in-memory retained-object recovery; not provider acceptance',
      postgresMajor: target.major, clientMajor: target.major, dumpBytes: dump.length, dumpSha256: digest(dump),
      catalogNormalization: 'Only associative AND grouping of the exact 1..99999999 range in two named financial CHECKs; restored rejection probes also executed',
      preserved: expected, artifacts: seed.descriptions, checks: ['full row hashes', 'schema/catalog equality',
        'quote/attempt/Vault guards', 'legacy nulls', 'synthetic neon_auth', 'retained image/PDF bytes',
        'corruption detection', 'base unchanged'], externalGates: ['provider-owned roles/ACLs', 'Neon PITR', 'real S3 recovery', 'physical opening/printing'] };
  } finally {
    const failures: unknown[] = [];
    const disconnected = await Promise.allSettled([source?.$disconnect(), restored?.$disconnect()]);
    for (const result of disconnected) if (result.status === 'rejected') failures.push(result.reason);
    try {
      // No FORCE: never terminate other connections or widen the target after failure.
      cleanupOwnedScratch(target.base, created, name => psql(target.base, `DROP DATABASE ${identifier(name)}`));
    } catch (error) { failures.push(error); }
    try {
      if (before) assert.deepEqual(await snapshot(base), before, 'Base changed after scratch cleanup');
    } catch (error) { failures.push(error); }
    try { await base.$disconnect(); } catch (error) { failures.push(error); }
    if (failures.length) {
      console.error(`Remaining acknowledged owned scratch databases: ${[...created].join(', ') || 'none'}`);
      throw new AggregateError(failures, 'Scratch cleanup/base verification failed; no passing report');
    }
    console.log('Owned scratch databases cleaned; selected base unchanged.');
  }
  assert.ok(report, 'No passing restore report');
  writeFileSync(resolve(output, 'evidence.json'), JSON.stringify({ ...report,
    finishedAt: new Date().toISOString(), ownedScratchCleanup: true, baseUnchangedAfterCleanup: true }, null, 2) + '\n');
  console.log(`PG${target.major}: logical restore, catalog/data preservation and local object recovery passed.`);
}
if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  rehearse().catch(error => {
    const message = error instanceof Error ? error.message : 'Unknown failure';
    console.error('Local restore rehearsal failed:', message.replace(/postgres(?:ql)?:\/\/[^\s]+/g, '[redacted URL]'));
    process.exitCode = 1;
  });
}
