{
  "name": "titchybook-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "audit:dependencies": "npm audit --audit-level=low",
    "test:pricing": "tsx src/lib/pricing/__tests__/engine.test.ts",
    "test:email": "tsx test-email.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:migrate": "tsx scripts/test-db.ts migrate",
    "test:integration": "tsx scripts/test-db.ts integration",
    "test:browser": "tsx scripts/test-db.ts browser",
    "worker:render": "tsx src/workers/render-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "konva": "^10.2.5",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.39.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
